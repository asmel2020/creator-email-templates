{
  "name": "template-app",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply template-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply template-db --remote",
    "db:reset": "tsx src/shared/db/seed/reset-db.ts",
    "db:seed": "tsx src/shared/db/seed/seed.ts",
    "db:seed:local": "tsx src/shared/db/seed/seed.ts",
    "db:seed:remote": "tsx src/shared/db/seed/seed.ts --remote",
    "db:setup:local": "pnpm run db:migrate:local && pnpm run db:seed:local",
    "db:setup:remote": "pnpm run db:migrate:remote && pnpm run db:seed:remote"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1088.0",
    "@aws-sdk/s3-request-presigner": "^3.1088.0",
    "@hono/standard-validator": "^0.4.0",
    "@hono/swagger-ui": "^0.6.1",
    "create-email-renderer": "workspace:*",
    "bcryptjs": "^3.0.3",
    "big.js": "^7.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "hono-openapi": "^1.3.1",
    "jose": "^6.2.3",
    "openai": "^6.47.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/big.js": "^7.0.0",
    "@types/uuid": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "wrangler": "^4.110.0"
  }
}
