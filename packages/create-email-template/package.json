{
  "name": "create-email-template",
  "version": "0.1.1",
  "description": "Reusable email template builder (blocks, canvas, options) with a zero-dependency React store and shadcn/ui",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "check-types": "tsc -p tsconfig.app.json --noEmit",
    "prepublishOnly": "pnpm build && pnpm check-types"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-email/components": "^0.3.1",
    "@react-email/render": "^1.1.4",
    "create-email-renderer": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react-hot-toast": "^2.5.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "shadcn": "^4.19.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "license": "MIT",
  "author": "asmel2020",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/asmel2020/creator-email#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asmel2020/creator-email.git",
    "directory": "packages/create-email-template"
  }
}
